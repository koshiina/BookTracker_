@model BookTracker_.Models.Parameters

<div class="container">
    <h2>Add New Book to Your Library</h2>
    <form asp-action="Create" method="post">
        <div>
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div>
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
        </div>
        <div>
            <label asp-for="PageCount" class="form-label"></label>
            <input asp-for="PageCount" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Add Book</button>
    </form>
</div>
